{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "autorundown",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "serve.py",
        "--port",
        "8756"
      ],
      "port": 8756
    },
    {
      "name": "autorundown-sample-wis",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "serve.py",
        "--port",
        "8757",
        "--index",
        "sample_wis.db"
      ],
      "port": 8757
    },
    {
      "name": "autorundown-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "dev.py",
        "--no-browser"
      ],
      "port": 8757
    },
    {
      "name": "autorundown-dev-fakevm",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "dev.py",
        "--no-browser",
        "--fake-vm",
        "--fake-api"
      ],
      "port": 8757
    }
  ]
}